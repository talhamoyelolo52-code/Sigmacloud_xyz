# Discord Bot Token (from Discord Developer Portal)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Bot Owner Discord IDs (comma separated)
OWNER_IDS=123456789,987654321

# Command Prefix
PREFIX=.

# Starting Credits for New Users
STARTING_CREDITS=20

# Pricing
PRICE_100_EMAILS=2
PRICE_1000_EMAILS=20

# Cooldown in milliseconds (1 hour = 3600000ms)
COOLDOWN_MS=3600000

# Cooldown threshold (emails that trigger cooldown)
COOLDOWN_THRESHOLD=1000
